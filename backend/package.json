  "scripts": {
    "prisma:studio": "npx prisma studio",
    "prisma:studio:browser": "start firefox http://localhost:5555",
    "swagger:docs": "start firefox http://localhost:3000/api/docs/",
    "docker:desktop": "tasklist /FI \"IMAGENAME eq Docker Desktop.exe\" | find /I \"Docker Desktop.exe\" >nul || start \"\" \"C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe\"",
